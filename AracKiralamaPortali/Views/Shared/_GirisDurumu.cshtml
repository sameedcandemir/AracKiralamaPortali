<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link site-kullanici">@User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Hesap" asp-action="Cikis" method="post">
                <button type="submit" class="nav-link border-0 bg-transparent">Çıkış Yap</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Hesap" asp-action="Giris">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-vurgu" asp-area="" asp-controller="Hesap" asp-action="Kayit">Kayıt Ol</a>
        </li>
    }
</ul>
