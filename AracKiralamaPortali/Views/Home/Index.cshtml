@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center py-4">
    <h1 class="display-5">Araç Kiralama Portalı</h1>
    <p class="lead">Şubelerimizdeki araçları inceleyin, tarih seçin ve hemen rezervasyon yapın.</p>
</div>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Geniş araç seçeneği</h5>
                <p class="card-text">Ekonomi, SUV ve lüks kategorilerinde araçlar.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Farklı şubeler</h5>
                <p class="card-text">Aracı bir şubeden alıp başka bir şubeye iade edebilirsiniz.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Kolay rezervasyon</h5>
                <p class="card-text">Müsait araçları görün, ücreti önceden öğrenin.</p>
            </div>
        </div>
    </div>
</div>
